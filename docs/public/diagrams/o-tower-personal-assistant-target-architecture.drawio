        <mxCell id="17" value="Tower 个人工作中枢" style="swimlane;startSize=36;html=1;fillColor=#f4f8ff;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1050" y="120" width="700" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="18" value="Tower 不重复判断平台 OWNER；只接受签名内部调用，并强制项目范围、Workbench 归属、幂等与状态机约束。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;fontSize=13;fontStyle=1;" vertex="1" parent="17">
          <mxGeometry x="30" y="60" width="640" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="19" value="Owner Control Plane&#xa;查询可在入口完成；写操作全部入 Workbench&#xa;执行、恢复、诊断与审批均有持久归属" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="17">
          <mxGeometry x="30" y="390" width="640" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="20" value="Project Reader Surface&#xa;仅可信 Channel 的 NON_OWNER 可用&#xa;绑定 Workspace 内：代码 / 知识库 / 项目任务状态&#xa;禁止个人日报与任何修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="17">
          <mxGeometry x="30" y="530" width="640" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="远程项目接入编排器&#xa;OWNER only&#xa;缺 Workspace / 本地根目录则持久询问" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="17">
          <mxGeometry x="30" y="650" width="300" height="90" as="geometry"/>
