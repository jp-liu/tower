        <mxCell id="3" value="身份与权限归 OpenClaw；Tower 保持单机个人工作中枢，不维护同事账号或 sender RBAC。" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#4b5563;" vertex="1" parent="1">
