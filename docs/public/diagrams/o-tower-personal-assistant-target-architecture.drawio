          <mxGeometry x="20" y="220" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="Identity + Trusted Channel Policy&#xa;稳定 ID 判 OWNER；chatId 判可信入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="9">
