        <mxCell id="22" value="项目只读讨论与查询&#xa;Workspace 绑定范围&#xa;项目级回答，不暴露个人聚合信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="17">
