  <diagram id="runtime-loop" name="02 运行循环">
    <mxGraphModel dx="1840" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-title" value="Workbench 可靠命令运行循环（第一阶段已实现）" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1780" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-subtitle" value="队列事实、PTY 回合状态和 Runtime 健康状态彼此分离；只有 provider-confirmed boundary 可以触发投递" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1780" height="30" as="geometry" />
        </mxCell>

        <mxCell id="source-lane" value="1  发布与持久化" style="swimlane;startSize=36;rounded=0;html=1;fillColor=#f9fafb;strokeColor=#6b7280;fontStyle=1;fontSize=15;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1760" height="180" as="geometry" />
        </mxCell>
        <mxCell id="publish" value="publishWorkbenchCommand&#xa;稳定 dedupKey / source / payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="source-lane">
          <mxGeometry x="50" y="60" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pending" value="Durable Inbox&#xa;PENDING" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;" vertex="1" parent="source-lane">
          <mxGeometry x="500" y="55" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="no-subscriber" value="Lifecycle 无 observer&#xa;通知 no-op，不影响核心&#xa;当前不持久化 Domain Event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=13;" vertex="1" parent="source-lane">
          <mxGeometry x="930" y="60" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="no-owner" value="Command owner 固定为 Workbench&#xa;沿用现有 enum 与 producer 校验&#xa;不建设动态 owner registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="source-lane">
          <mxGeometry x="1360" y="55" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="dispatch-lane" value="2  调度与安全边界" style="swimlane;startSize=36;rounded=0;html=1;fillColor=#f9fafb;strokeColor=#6b7280;fontStyle=1;fontSize=15;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1760" height="260" as="geometry" />
        </mxCell>
        <mxCell id="wake" value="Wakeup&#xa;enqueue fast path + 2s reconciler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="dispatch-lane">
          <mxGeometry x="50" y="90" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="boundary-check" value="PTY state =&#xa;AT_TURN_BOUNDARY?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="dispatch-lane">
          <mxGeometry x="410" y="75" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="wait-boundary" value="保持 PENDING&#xa;Runtime = BUSY（RUNNING 语义）&#xa;不打断当前 Agent 回合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="dispatch-lane">
          <mxGeometry x="720" y="60" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="claim" value="Claim Batch&#xa;CLAIMED + lease + generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="dispatch-lane">
          <mxGeometry x="1080" y="60" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" value="Deliver to Workbench PTY&#xa;DISPATCHED&#xa;Runtime = BUSY（RUNNING 语义）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="dispatch-lane">
          <mxGeometry x="1440" y="60" width="270" height="110" as="geometry" />
        </mxCell>

        <mxCell id="execute-lane" value="3  Workbench 单线程回合" style="swimlane;startSize=36;rounded=0;html=1;fillColor=#f9fafb;strokeColor=#6b7280;fontStyle=1;fontSize=15;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1760" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ack" value="ACKED&#xa;确认接手，开始 processing lease" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="execute-lane">
          <mxGeometry x="1410" y="80" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="handle" value="Handle / Delegate&#xa;领域操作 + heartbeat&#xa;可继续发布 Workbench command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="execute-lane">
          <mxGeometry x="1020" y="70" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="resolve" value="RESOLVED&#xa;batch 完成 / command CONSUMED&#xa;Runtime 仍为 BUSY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="execute-lane">
          <mxGeometry x="630" y="70" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="provider-stop" value="Provider stop / end_turn&#xa;唯一权威回合完成信号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="execute-lane">
          <mxGeometry x="300" y="80" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="PTY = AT_TURN_BOUNDARY&#xa;Runtime = IDLE&#xa;（READY 语义）&#xa;开放一次性 drain token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="execute-lane">
          <mxGeometry x="50" y="70" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="recovery" value="恢复侧路：租约过期 → Batch FAILED → command 回到 PENDING；用同一稳定 batch id、新 lease 重放。PTY write 后崩溃允许终端输入 at-least-once，但旧 lease 被 fencing，持久副作用只消费一次。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="240" y="940" width="1320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="state-note" value="实现保留数据库枚举 IDLE / BUSY 以避免无收益迁移：IDLE 表示 READY，BUSY 表示 RUNNING；pending count 与 active batch 仍是独立投影字段。" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4b5563;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="1015" width="1320" height="35" as="geometry" />
        </mxCell>

        <mxCell id="p2-e-publish" value="同事务持久化" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="source-lane" source="publish" target="pending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-pending-wake" value="有 delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pending" target="wake">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="320" />
              <mxPoint x="220" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-wake-check" value="尝试 drain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="dispatch-lane" source="wake" target="boundary-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-no" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="dispatch-lane" source="boundary-check" target="wait-boundary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-yes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="boundary-check" target="claim">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="385" />
              <mxPoint x="1250" y="385" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-claim-dispatch" value="write + submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="dispatch-lane" source="claim" target="dispatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-dispatch-ack" value="Agent 读取并接手" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dispatch" target="ack">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-ack-handle" value="处理责任" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="execute-lane" source="ack" target="handle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-handle-resolve" value="处理或稳定委派完成" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="execute-lane" source="handle" target="resolve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-resolve-stop" value="Agent 继续收尾" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="execute-lane" source="resolve" target="provider-stop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-stop-ready" value="权威边界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="execute-lane" source="provider-stop" target="ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-ready-loop" value="若仍有 PENDING，进入下一轮" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ready" target="boundary-check">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="185" y="620" />
              <mxPoint x="560" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-wait-loop" value="provider stop 后再唤醒" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="wait-boundary" target="provider-stop">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="885" y="620" />
              <mxPoint x="610" y="620" />
              <mxPoint x="610" y="770" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
