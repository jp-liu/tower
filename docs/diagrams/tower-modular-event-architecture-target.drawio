        <mxCell id="e-pub-event" value="lifecycle signal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="tower" source="publish-port" target="event-lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-command-dispatch" value="claim + deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.8;entryY=0;" edge="1" parent="1" source="command-lane" target="dispatcher">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1280" y="265" />
              <mxPoint x="1280" y="530" />
              <mxPoint x="1208" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-event-dispatch" value="turn-boundary gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="event-lane" target="dispatcher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-dispatch-bus" value="投递" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="tower" source="dispatcher" target="module-bus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-bus-task" value="handle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="tower" source="module-bus" target="task-module">
