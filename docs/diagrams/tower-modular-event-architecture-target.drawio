        <mxCell id="e-clock" value="触发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.84;" edge="1" parent="1" source="ext-clock" target="ports">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ports-publish" value="publish / notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="tower" source="ports" target="publish-port">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-pub-command" value="durable command" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="tower" source="publish-port" target="command-lane">
          <mxGeometry relative="1" as="geometry" />
