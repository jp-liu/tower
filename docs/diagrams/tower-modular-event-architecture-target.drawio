<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.4.1" pages="2">
  <diagram id="module-boundaries" name="01 模块边界">
    <mxGraphModel dx="1840" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Tower 模块化事件架构（第一阶段已实现）" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1780" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="一个代码库、一个进程、一个数据库；用具体薄函数边界隔离 PTY、Workbench 与 Gateway，不建设通用事件总线" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1780" height="30" as="geometry" />
        </mxCell>

        <mxCell id="external" value="外部世界" style="swimlane;startSize=36;rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=15;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="240" height="700" as="geometry" />
        </mxCell>
        <mxCell id="ext-ui" value="Tower UI / API&#xa;用户操作与服务调用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="external">
          <mxGeometry x="25" y="70" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ext-provider" value="Provider / PTY&#xa;turn-complete 回调" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="external">
          <mxGeometry x="25" y="200" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ext-platform" value="OpenClaw / 飞书&#xa;可选外部入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=14;" vertex="1" parent="external">
          <mxGeometry x="25" y="330" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ext-clock" value="Clock / Scheduler&#xa;延时与周期触发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=14;" vertex="1" parent="external">
          <mxGeometry x="25" y="460" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="tower" value="Tower Monolith  ·  逻辑模块化边界" style="swimlane;startSize=40;rounded=0;html=1;fillColor=#ffffff;strokeColor=#4b5563;fontStyle=1;fontSize=16;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="1500" height="850" as="geometry" />
        </mxCell>

        <mxCell id="ports" value="组合根与入口适配器&#xa;&#xa;instrumentation-node.ts&#xa;Provider Stop Hook&#xa;Gateway Router&#xa;2s Reconciler&#xa;&#xa;注册 lifecycle adapter；入口只做协议转换、鉴权和幂等键提取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=left;spacingLeft=18;verticalAlign=top;spacingTop=18;" vertex="1" parent="tower">
          <mxGeometry x="40" y="100" width="260" height="500" as="geometry" />
        </mxCell>

        <mxCell id="publish-port" value="Workbench Command Inbox&#xa;publish · activate · restore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="tower">
          <mxGeometry x="360" y="170" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="command-lane" value="Durable Workbench Commands&#xa;WorkbenchEvent: PENDING → PROCESSING → CONSUMED&#xa;唯一 Workbench owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="tower">
          <mxGeometry x="670" y="90" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="event-lane" value="Process-local Lifecycle&#xa;PTY input-start / provider-turn-complete&#xa;Workbench batch-dispatched&#xa;无通用 Domain Event bus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="tower">
          <mxGeometry x="670" y="260" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dispatcher" value="Workbench Coordinator&#xa;lease · coalesce · ACK · heartbeat · replay&#xa;仅在 provider-confirmed turn boundary 投递" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="tower">
          <mxGeometry x="670" y="440" width="260" height="140" as="geometry" />
        </mxCell>

        <mxCell id="module-bus" value="THIN&#xa;PORTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="tower">
          <mxGeometry x="1000" y="150" width="90" height="410" as="geometry" />
        </mxCell>

        <mxCell id="task-module" value="Task / Execution Core&#xa;任务事实、状态流转、执行记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="tower">
          <mxGeometry x="1160" y="80" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="workbench-module" value="Workbench Core&#xa;项目编排、审查、委派、回合边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="tower">
          <mxGeometry x="1160" y="230" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gateway-module" value="Gateway Extension（可选）&#xa;外部路由、绑定、可靠回执&#xa;不被 Core / Workbench 直接 import" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=14;fontStyle=1;" vertex="1" parent="tower">
          <mxGeometry x="1160" y="380" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="future-module" value="Future Domain Events（未建设）&#xa;仅在出现两个独立事实消费者后评估" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=14;" vertex="1" parent="tower">
          <mxGeometry x="1160" y="540" width="290" height="100" as="geometry" />
        </mxCell>

        <mxCell id="sqlite" value="同一个 SQLite  ·  事务边界仍在 Tower 内" style="swimlane;startSize=34;rounded=0;html=1;fillColor=#f9fafb;strokeColor=#6b7280;fontStyle=1;fontSize=14;pointerEvents=0;" vertex="1" parent="tower">
          <mxGeometry x="350" y="660" width="1100" height="150" as="geometry" />
        </mxCell>
        <mxCell id="event-store" value="WorkbenchEvent / Batch / Runtime&#xa;命令、租约、重放与运行投影" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="sqlite">
          <mxGeometry x="40" y="45" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="domain-store" value="Core Domain Tables&#xa;Task / Execution / Message" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="sqlite">
          <mxGeometry x="410" y="45" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="extension-store" value="Extension-owned Tables&#xa;Gateway / Harness（按模块归属）" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="sqlite">
          <mxGeometry x="790" y="45" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="rule" value="依赖规则：PTY 只发布中性 lifecycle；Gateway 只调用 Workbench command inbox；Workbench 不解析 Gateway 私有 payload、不写 Gateway 表。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="330" y="985" width="1500" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e-ui" value="调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.18;" edge="1" parent="1" source="ext-ui" target="ports">
