        </mxCell>

        <mxCell id="a-port" value="CapabilityRequest 契约边界&#xa;（逻辑，不是新服务）&#xa;&#xa;Discovery + input/output schema&#xa;OWNER 授权 · requestId 去重&#xa;&#xa;上车道：Direct&#xa;下车道：Job" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;strokeWidth=2;fillColor=#fffdf5;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="740" y="130" width="270" height="610" as="geometry"/>
