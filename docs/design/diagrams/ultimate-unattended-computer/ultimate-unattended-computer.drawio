          <mxGeometry x="20" y="65" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a-agent" value="Gateway Client + tower-bridge&#xa;外部 CapabilityRequest" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="a-tower">
