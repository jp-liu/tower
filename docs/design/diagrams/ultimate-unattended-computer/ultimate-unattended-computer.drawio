        <mxCell id="a-unattended" value="Unattended Goal（可选）&#xa;运行态 · 唤醒策略 · 预算边界" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="a-tower">
