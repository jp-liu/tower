  <diagram id="overview" name="01-System-Overview">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a-title" value="终极无人值守电脑：系统职责与能力流" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1540" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="a-subtitle" value="请求从左向右执行，结果沿底部单线返回；Tower 管项目事实，OpenClaw 管渠道、授权与外部能力。" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1540" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="a-entry" value="入口" style="swimlane;startSize=34;html=1;container=1;pointerEvents=0;rounded=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="220" height="610" as="geometry"/>
        </mxCell>
        <mxCell id="a-human" value="人类 / OWNER&#xa;飞书、微信等渠道" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="a-entry">
          <mxGeometry x="20" y="65" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a-dev" value="开发者在场&#xa;Tower UI / MCP / Terminal" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="a-entry">
          <mxGeometry x="20" y="335" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a-entry-note" value="入口只决定把请求交给谁，&#xa;不复制另一系统的业务状态。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748b;" vertex="1" parent="a-entry">
          <mxGeometry x="20" y="500" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="a-openclaw" value="OpenClaw：个人工作流与电脑能力中枢" style="swimlane;startSize=34;html=1;container=1;pointerEvents=0;rounded=0;fillColor=#fff7ed;strokeColor=#d79b00;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="310" y="130" width="370" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="a-otower" value="o-tower&#xa;理解人类消息与会话" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="a-openclaw">
          <mxGeometry x="115" y="70" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a-open-state" value="Registry + Runtime State&#xa;能力路由 · 风险 · 身份 · 凭据 · Job / Operator 映射" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="a-openclaw">
          <mxGeometry x="30" y="155" width="310" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="a-tower" value="Tower：项目工作中枢" style="swimlane;startSize=34;html=1;container=1;pointerEvents=0;rounded=0;fillColor=#eff6ff;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="310" y="400" width="370" height="340" as="geometry"/>
        </mxCell>
