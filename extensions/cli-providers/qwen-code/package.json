{
  "name": "tower-extension-qwen-code",
  "version": "0.1.0",
  "description": "Community Qwen Code CLI provider for Tower",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tower-org/tower.git",
    "directory": "extensions/cli-providers/qwen-code"
  },
  "homepage": "https://github.com/tower-org/tower/tree/main/extensions/cli-providers/qwen-code#readme",
  "bugs": { "url": "https://github.com/tower-org/tower/issues" },
  "private": true,
  "type": "module",
  "exports": {
    "./tower-cli-provider": {
      "import": "./dist/index.js"
    },
    "./config.schema.json": "./config.schema.json"
  },
  "files": [
    "dist",
    "config.schema.json"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@tower-org/ai-sdk": "workspace:*"
  },
  "tower": {
    "manifestVersion": 1,
    "apiVersion": "1.0",
    "id": "community.qwen-code",
    "kind": "cli-provider",
    "publisher": {
      "id": "tower-community",
      "name": "Tower Community"
    },
    "display": {
      "name": "Qwen Code",
      "description": "Community provider for the Qwen Code CLI"
    },
    "entry": "./dist/index.js",
    "command": {
      "default": "qwen",
      "versionArgs": ["--version"]
    },
    "cliDependency": {
      "name": "Qwen Code CLI",
      "homepage": "https://github.com/QwenLM/qwen-code",
      "installDocs": "https://qwenlm.github.io/qwen-code-docs/en/users/installation/",
      "supportedVersions": ">=0.18.0 <1.0.0",
      "managedByTower": false
    },
    "compatibility": {
      "tower": ">=0.3.0 <1.0.0",
      "node": ">=20"
    },
    "capabilities": {
      "sessions": {
        "fresh": true,
        "resume": true,
        "continue": true
      },
      "query": {
        "generate": true,
        "stream": true
      },
      "models": false,
      "integrations": {
        "mcp": false,
        "hooks": false,
        "skills": false
      }
    },
    "permissions": [
      "process:spawn",
      "network:provider"
    ],
    "configSchema": "./config.schema.json"
  }
}
