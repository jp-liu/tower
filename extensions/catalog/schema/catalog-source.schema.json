{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tower.local/schemas/extension-catalog-source.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageDir", "extension"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "packageDir": { "type": "string", "minLength": 1 },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "publisher", "display", "versions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "kind": { "const": "cli-provider" },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "homepage": { "type": "string", "format": "uri" }
          }
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  }
}
