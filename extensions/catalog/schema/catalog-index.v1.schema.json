{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tower.local/schemas/extension-catalog-index.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "extensions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/extension" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string" },
        "homepage": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        }
      }
    },
    "cliDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "supportedVersions", "installDocs"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "supportedVersions": { "$ref": "#/$defs/nonEmptyString" },
        "installDocs": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifact"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "cliDependency": { "$ref": "#/$defs/cliDependency" }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "publisher", "display", "versions"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "const": "cli-provider" },
        "publisher": { "$ref": "#/$defs/publisher" },
        "display": { "$ref": "#/$defs/display" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/version" }
        }
      }
    }
  }
}
