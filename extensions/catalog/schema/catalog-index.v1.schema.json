{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tower.local/schemas/extension-catalog-index.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "extensions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "publisher", "display", "versions"]
      }
    }
  }
}
