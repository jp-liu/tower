{
  "schemaVersion": 1,
  "sourceAgent": "o-tower",
  "defaultPolicy": {
    "directCapabilities": ["tower"],
    "delegateExternalCapabilities": true,
    "noDefaultThirdPartyIntegration": true
  },
  "routes": [
    {
      "id": "external-spreadsheet",
      "description": "Spreadsheet and database-table work is delegated to a user-local office operator agent.",
      "match": [
        "表格",
        "多维表格",
        "电子表格",
        "spreadsheet",
        "sheet",
        "Bitable",
        "Base",
        "bitable",
        "base"
      ],
      "agent": "<operator-agent-id>",
      "delegateCommand": "openclaw agent --agent <operator-agent-id> --json --message-file <task-file>",
      "requiresConfirmationForWrite": true,
      "expectedOutput": {
        "ok": "boolean",
        "summary": "string",
        "actionsTaken": "array",
        "requiresUserConfirmation": "boolean",
        "risks": "array",
        "data": "object",
        "suggestedUserReply": "string"
      }
    },
    {
      "id": "external-document-space",
      "description": "Document pages, knowledge-base pages, Drive files, folders, and attachments are delegated to a user-local office operator agent.",
      "match": [
        "知识库",
        "文档页面",
        "云文档",
        "文件",
        "附件",
        "云盘",
        "文件夹",
        "wiki",
        "document"
      ],
      "agent": "<operator-agent-id>",
      "delegateCommand": "openclaw agent --agent <operator-agent-id> --json --message-file <task-file>",
      "requiresConfirmationForWrite": true,
      "expectedOutput": {
        "ok": "boolean",
        "summary": "string",
        "actionsTaken": "array",
        "requiresUserConfirmation": "boolean",
        "risks": "array",
        "data": "object",
        "suggestedUserReply": "string"
      }
    }
  ]
}
