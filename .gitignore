# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# build output
/dist
/packages/*/dist/

# dependencies
/node_modules
/packages/*/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next
/.next-dev
/.worktrees/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
# Unanchored on purpose: a `prisma/dev.db`-style rule only matches at the repo
# root, so a relative `file:` URL resolved against the schema dir (prisma/) once
# wrote prisma/prisma/dev.db straight past it and into a commit.
dev.db
dev.db-journal
dev.db-shm
dev.db-wal
dev.db.bak-*

# Monaco editor (copied from node_modules by postinstall)
public/vs/

# runtime data
/data/

# Tower runtime (generated by init-tower.ts at startup)
.tower/

# Claude Code runtime
.agents/
.claude/worktrees/
.claude/skills/
skills-lock.json

# GSD planning (local dev workflow)
.planning/

# Docs site
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Local notes (TODO, pitfalls, etc.) — not committed
.notes/

# Release tarballs (generated by `npm pack` / `pnpm release:smoke`)
tower-studio-*.tgz
.gstack/
