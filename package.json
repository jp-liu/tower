{
  "name": "tower-studio",
  "version": "0.1.21",
  "description": "AI Task Orchestration Platform — Kanban + Terminal + Code Editor + MCP",
  "bin": {
    "tower": "bin/tower.mjs"
  },
  "files": [
    "bin/",
    ".next/",
    "public/",
    "prisma/schema.prisma",
    "prisma/init-fts.ts",
    "scripts/init-db.ts",
    "scripts/generate-prisma-client.js",
    "scripts/link-prisma.js",
    "scripts/fix-native-permissions.js",
    "scripts/migrate-data.ts",
    "scripts/copy-monaco.js",
    "scripts/post-tool-hook.js",
    "scripts/session-start-hook.js",
    "scripts/stop-hook.js",
    "src/mcp/",
    "next.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "predev": "node scripts/ensure-dev-db.js",
    "dev": "next dev --webpack -p 9022",
    "build": "next build",
    "build:clean": "rm -rf .next && next build && find .next -name '*.map' -delete",
    "release": "pnpm build:clean && npm pack",
    "release:smoke": "node scripts/release-smoke.js",
    "release:publish": "pnpm build:clean && npm publish",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:init": "tsx scripts/init-db.ts",
    "db:init-fts": "tsx prisma/init-fts.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "NO_PROXY=localhost,127.0.0.1 no_proxy=localhost,127.0.0.1 playwright test",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "mcp": "tsx src/mcp/index.ts",
    "postinstall": "node scripts/copy-monaco.js && node scripts/generate-prisma-client.js && node scripts/link-prisma.js && node scripts/fix-native-permissions.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@vscode/ripgrep",
      "esbuild",
      "node-pty",
      "prisma"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@monaco-editor/react": "4.8.0-rc.3",
    "@prisma/client": "^6.19.2",
    "@tailwindcss/typography": "^0.5.19",
    "@uiw/react-md-editor": "^4.0.11",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.3.0",
    "ignore": "^7.0.5",
    "lucide-react": "^1.6.0",
    "monaco-editor": "^0.55.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "prisma": "^6.19.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-reverse-portal": "^2.3.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.0",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tar": "^7.5.13",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "optionalDependencies": {
    "@vscode/ripgrep": "^1.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar": "^7.0.87",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
}
