{
  "name": "@tower-org/cli",
  "version": "0.3.1",
  "description": "AI Task Orchestration Platform — Kanban + Terminal + Code Editor + MCP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tower-org/tower.git"
  },
  "homepage": "https://github.com/tower-org/tower#readme",
  "bugs": {
    "url": "https://github.com/tower-org/tower/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "bin": {
    "tower": "bin/tower.mjs"
  },
  "files": [
    "bin/",
    ".next/standalone/",
    "prisma/schema.prisma",
    "prisma/init-fts.ts",
    "prisma/pre-migration.sql",
    "scripts/init-db.ts",
    "scripts/generate-prisma-client.js",
    "scripts/link-embedded-packages.js",
    "scripts/link-prisma.js",
    "scripts/fix-native-permissions.js",
    "scripts/post-install-banner.js",
    "scripts/prune-standalone-natives.js",
    "scripts/migrate-data.ts",
    "scripts/run-migrations.ts",
    "scripts/migrations/",
    "scripts/tower-post-tool-hook.js",
    "scripts/tower-codex-notify.js",
    "scripts/tower-session-start-hook.js",
    "scripts/tower-stop-hook.js",
    "dist/mcp-server.cjs",
    "packages/ai-sdk/package.json",
    "packages/ai-sdk/dist/",
    "packages/ai-runtime/package.json",
    "packages/ai-runtime/dist/",
    "packages/ai-provider-claude/package.json",
    "packages/ai-provider-claude/dist/",
    "packages/ai-provider-claude/config.schema.json",
    "packages/ai-provider-codex/package.json",
    "packages/ai-provider-codex/dist/",
    "packages/ai-provider-codex/config.schema.json",
    "packages/ai-provider-gemini/package.json",
    "packages/ai-provider-gemini/dist/",
    "packages/ai-provider-gemini/config.schema.json",
    "docs/licenses/models.dev-MIT.md",
    "skills/",
    "extensions/catalog/",
    "extensions/tower-agent/",
    "tsconfig.json"
  ],
  "scripts": {
    "predev": "pnpm ai:packages:build && TOWER_DATA_DIR=\"$HOME/.tower-dev\" DATABASE_URL=\"file:$HOME/.tower-dev/database/tower.db\" node scripts/ensure-dev-db.js && pnpm db:migrate && pnpm mcp:build",
    "dev": "NEXT_DISTDIR=.next-dev TOWER_DATA_DIR=\"$HOME/.tower-dev\" DATABASE_URL=\"file:$HOME/.tower-dev/database/tower.db\" env -u NODE_ENV -u TURBOPACK next dev --webpack -H 127.0.0.1 -p 9022",
    "build": "pnpm ai:packages:build && pnpm mcp:build && rm -rf .next && env -u __NEXT_PRIVATE_STANDALONE_CONFIG -u __NEXT_PRIVATE_ORIGIN -u TURBOPACK next build && find .next -name '*.map' -delete && cp -R .next/static .next/standalone/.next/ && cp -R public .next/standalone/ && node scripts/prune-standalone-natives.js",
    "release": "bash scripts/release.sh",
    "release:gate": "node scripts/release-gate.js",
    "release:prepare": "pnpm release:gate && pnpm test:e2e:release && pnpm release:pack:check && pnpm release:entrypoints:check",
    "release:smoke": "node scripts/release-smoke.js",
    "release:smoke:published": "TOWER_SMOKE_PACKAGE_SPEC='@tower-org/cli@0.3.1' node scripts/release-smoke.js",
    "release:pack:check": "node scripts/release-package-canary.js",
    "release:entrypoints:check": "node scripts/check-release-entrypoints.js",
    "release:publish": "bash scripts/release.sh --publish",
    "start": "node bin/tower.mjs",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "DATABASE_URL=\"file:$HOME/.tower-dev/database/tower.db\" prisma db push",
    "db:seed": "DATABASE_URL=\"file:$HOME/.tower-dev/database/tower.db\" tsx prisma/seed.ts",
    "db:studio": "DATABASE_URL=\"file:$HOME/.tower-dev/database/tower.db\" prisma studio",
    "db:init": "TOWER_DATA_DIR=\"$HOME/.tower-dev\" DATABASE_URL=\"file:$HOME/.tower-dev/database/tower.db\" tsx scripts/init-db.ts",
    "db:init-fts": "DATABASE_URL=\"file:$HOME/.tower-dev/database/tower.db\" tsx prisma/init-fts.ts",
    "db:migrate": "TOWER_DATA_DIR=\"$HOME/.tower-dev\" DATABASE_URL=\"file:$HOME/.tower-dev/database/tower.db\" tsx scripts/run-migrations.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "pnpm build && TOWER_E2E_RUN_ID=$$ NO_PROXY=localhost,127.0.0.1 no_proxy=localhost,127.0.0.1 playwright test",
    "test:e2e:release": "pnpm build && TOWER_E2E_RUN_ID=$$ NO_PROXY=localhost,127.0.0.1 no_proxy=localhost,127.0.0.1 playwright test tests/e2e/release-smoke.spec.ts --workers=1",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "ai:presets:update": "tsx scripts/update-ai-presets.ts",
    "ai:packages:build": "pnpm --filter './packages/**' -r build",
    "extensions:catalog:build": "pnpm --filter @tower-org/ai-sdk build && pnpm --filter tower-extension-qwen-code build && tsx scripts/build-extension-catalog.ts",
    "extensions:catalog:validate": "tsx scripts/validate-extension-catalog.mts",
    "mcp": "node dist/mcp-server.cjs",
    "mcp:build": "esbuild src/mcp/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/mcp-server.cjs --external:@prisma/client --external:@modelcontextprotocol/sdk --external:@opentelemetry/api --alias:@=./src",
    "mcp:dev": "tsx src/mcp/index.ts",
    "postinstall": "node scripts/link-embedded-packages.js && node scripts/generate-prisma-client.js && node scripts/link-prisma.js && node scripts/fix-native-permissions.js && node scripts/post-install-banner.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "node-pty",
      "prisma"
    ],
    "overrides": {
      "@hono/node-server": "2.0.12",
      "body-parser": "2.3.0",
      "defu": "6.1.5",
      "effect": "3.20.0",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.4",
      "hono": "4.12.27",
      "ip-address": "10.1.1",
      "path-to-regexp": "8.4.0",
      "qs": "6.15.2"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.20",
    "@ai-sdk/google": "4.0.24",
    "@ai-sdk/openai": "4.0.20",
    "@ai-sdk/openai-compatible": "3.0.14",
    "@ai-sdk/provider": "4.0.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.19.2",
    "@vscode/ripgrep": "1.18.0",
    "ai": "7.0.18",
    "ajv": "8.18.0",
    "node-pty": "^1.1.0",
    "prisma": "^6.19.2",
    "semver": "7.7.4",
    "server-only": "0.0.1",
    "tar": "7.5.22",
    "tinykeys": "^4.0.0",
    "tsx": "^4.21.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tower-org/ai-provider-claude": "workspace:*",
    "@tower-org/ai-provider-codex": "workspace:*",
    "@tower-org/ai-provider-gemini": "workspace:*",
    "@tower-org/ai-runtime": "workspace:*",
    "@tower-org/ai-sdk": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/react": "^6.0.2",
    "@monaco-editor/react": "4.8.0-rc.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shell-quote": "^1.7.5",
    "@types/tar": "^7.0.87",
    "@types/ws": "^8.18.1",
    "@uiw/react-md-editor": "^4.0.11",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "conventional-changelog-cli": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "fuse.js": "^7.3.0",
    "ignore": "^7.0.5",
    "jsdom": "^29.0.1",
    "lucide-react": "^1.6.0",
    "monaco-editor": "^0.55.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "parse-diff": "^0.12.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^2.1.9",
    "react-reverse-portal": "^2.3.0",
    "shadcn": "^4.1.0",
    "shell-quote": "^1.8.3",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tar": "^7.5.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  }
}
