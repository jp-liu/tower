{
  "name": "@tower-org/ai-runtime",
  "version": "0.1.0",
  "description": "Private Tower host runtime for CLI provider plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tower-org/tower.git",
    "directory": "packages/ai-runtime"
  },
  "homepage": "https://github.com/tower-org/tower/tree/main/packages/ai-runtime#readme",
  "bugs": { "url": "https://github.com/tower-org/tower/issues" },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.20",
    "@ai-sdk/google": "4.0.24",
    "@ai-sdk/openai": "4.0.20",
    "@ai-sdk/openai-compatible": "3.0.14",
    "@ai-sdk/provider": "4.0.3",
    "@tower-org/ai-sdk": "workspace:*",
    "ai": "7.0.18",
    "ajv": "8.18.0",
    "semver": "7.7.4",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
}
