generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects     Project[]
  labels       Label[]
  prompts      AgentPrompt[]
  versionTypes VersionType[]
}

model Project {
  id          String      @id @default(cuid())
  name        String
  alias       String?
  description String?
  type           ProjectType     @default(NORMAL)
  gitUrl         String?
  localPath      String?
  projectType    ProjectCategory @default(FRONTEND)
  previewCommand String?
  previewPort    Int?
  previewPreset  String?
  previewInstallCommand String?
  workspaceId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks        Task[]
  repositories Repository[]
  notes        ProjectNote[]
  assets       ProjectAsset[]
  versions     Version[]

  @@index([workspaceId])
}

model Label {
  id          String  @id @default(cuid())
  name        String
  color       String  @default("#94a3b8")
  workspaceId String?
  isBuiltin   Boolean @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@index([workspaceId])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  order       Int        @default(0)
  pinned      Boolean    @default(false)
  promptId    String?
  baseBranch  String?
  subPath     String?
  parentTaskId String?   // 派生来源：派生此任务的父任务 id（父任务终端注入的 TOWER_TASK_ID）。裸字符串无 relation，与 promptId 同惯例
  previewCommandOverride String?
  previewPortOverride    Int?
  projectId   String
  versionId   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  doneAt      DateTime?  // 进入 DONE 的时间戳，用于「归档期限」判定（离开 DONE 时清空）

  // 无人值守：开启后 ask_human / notify_human / done-failed 回执会主动推通知；关闭则只在 UI 内显示等待，不打扰
  unattended    Boolean   @default(false)
  // ask_human 通知回流绑定：渠道 id（如 "feishu"）+ 目标地址（JSON 字符串，如 {"chatId":"oc_..","threadId":"om_.."}）
  notifyChannel String?
  notifyTarget  String?

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions TaskExecution[]
  messages   TaskMessage[]
  labels     TaskLabel[]
  notes      ProjectNote[]
  assets     ProjectAsset[]
  humanInputs HumanInputRequest[]
  version    Version?        @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([versionId])
  @@index([parentTaskId])
}

model TaskExecution {
  id             String          @id @default(cuid())
  taskId         String
  agent          String          @default("CLAUDE_CODE")
  config         String?         @default("DEFAULT")
  status         ExecutionStatus @default(PENDING)
  branch         String?
  sessionId      String?
  worktreePath   String?
  worktreeBranch String?
  startedAt      DateTime?
  endedAt        DateTime?
  summary        String?
  gitLog         String?
  gitStats       String?
  exitCode       Int?
  callbackUrl    String?
  terminalLog    String?
  forkCommit      String?
  mergeCommit     String?
  branchTipCommit String?
  createdAt      DateTime        @default(now())

  insightNoteId   String?
  insightNote     ProjectNote? @relation(fields: [insightNoteId], references: [id], onDelete: SetNull)

  task     Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  messages TaskMessage[]

  @@index([taskId])
  @@index([insightNoteId])
}

// 无人值守：agent 调 ask_human 时落一条 PENDING，人回复后转 ANSWERED；park/resume 闭环的持久化载体。
model HumanInputRequest {
  id          String   @id @default(cuid())
  taskId      String
  executionId String?
  question    String
  status      HumanInputStatus @default(PENDING)
  answer      String?
  createdAt   DateTime @default(now())
  answeredAt  DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
}

enum HumanInputStatus {
  PENDING
  ANSWERED
  CANCELLED
}

model TaskMessage {
  id          String      @id @default(cuid())
  role        MessageRole
  content     String
  taskId      String
  executionId String?
  metadata    String?
  createdAt   DateTime    @default(now())

  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  execution TaskExecution? @relation(fields: [executionId], references: [id])

  @@index([taskId])
  @@index([executionId])
}

model Repository {
  id        String   @id @default(cuid())
  name      String
  path      String
  branch    String   @default("main")
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Version {
  id            String        @id @default(cuid())
  number        String
  name          String
  typeId        String?
  status        VersionStatus @default(PLANNED)
  isCurrent     Boolean       @default(false)
  baseBranch    String?
  baseCommit    String?
  releaseCommit String?
  startDate     DateTime?
  targetDate    DateTime?
  releasedAt    DateTime?
  description   String?
  order         Int           @default(0)
  projectId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type    VersionType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([projectId])
  @@index([isCurrent])
  @@index([typeId])
}

model VersionType {
  id          String    @id @default(cuid())
  name        String
  workspaceId String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    Version[]

  @@index([workspaceId])
}

model ProjectNote {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("备忘")
  projectId String
  taskId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  insightExecutions TaskExecution[]

  @@index([projectId])
  @@index([taskId])
  @@index([category])
}

model ProjectAsset {
  id          String   @id @default(cuid())
  filename    String
  path        String
  mimeType    String?
  size        Int?
  description String?  @default("")
  projectId   String
  taskId      String?
  // 自动上传去重：sourceKey 是来源文件的稳定逻辑标识（剥离 worktree 前缀的项目相对路径），
  // contentHash 是内容 sha256。同一文件再次写入按 (projectId, sourceKey) 就地更新，
  // 内容未变则幂等跳过 —— 避免每次编辑都追加时间戳生成新资产。旧记录二者为 null。
  sourceKey   String?
  contentHash String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([projectId, sourceKey])
  @@index([projectId])
  @@index([taskId])
}

model AgentConfig {
  id           String   @id @default(cuid())
  agent        String
  configName   String
  appendPrompt String?
  settings     String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([agent, configName])
}

model CliProfile {
  id        String   @id @default(cuid())
  name      String   @unique
  command   String
  baseArgs  String   @default("[]")
  envVars   String   @default("{}")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiCapabilityConfig {
  id        String   @id @default(cuid())
  slot      String   @unique
  provider  String   @default("claude")
  mode      String   @default("cli")
  model     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentPrompt {
  id          String     @id @default(cuid())
  name        String
  description String?
  content     String
  isDefault   Boolean    @default(false)
  workspaceId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per AI provider that has been tested via Settings → Test Connection.
/// Capability slots can only select a provider that has a row here with
/// testOk=true and the relevant integrations installed. See
/// .notes/ai-provider-integration.md and .notes/ai-capability-slots.md.
model ProviderConnection {
  id              String   @id @default(cuid())
  /// Provider key from providerRegistry: "claude" | "codex" | ...
  provider        String   @unique
  /// Last time the user clicked Test Connection (regardless of outcome).
  lastTestedAt    DateTime?
  /// Outcome of the last hello probe.
  testOk          Boolean  @default(false)
  /// CLI version captured at last test, e.g. "1.0.0 (Claude Code)".
  version         String?
  mcpInstalled    Boolean  @default(false)
  hooksInstalled  Boolean  @default(false)
  skillsInstalled Boolean  @default(false)
  /// Most recent install report, for debugging / Show Last Install button.
  installLog      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Ledger of one-shot data migrations applied to THIS database (see
/// scripts/run-migrations.ts + scripts/migrations/). Bound to the DB so the
/// "already migrated" record can never drift from the data it describes.
model AppliedMigration {
  /// Migration id = filename without extension, e.g. "0001-insight-category".
  id        String   @id
  appliedAt DateTime @default(now())
}

enum ProjectType {
  NORMAL
  GIT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutionStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ProjectCategory {
  FRONTEND
  BACKEND
}

enum VersionStatus {
  PLANNED
  ACTIVE
  RELEASED
}
