generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects      Project[]
  labels        Label[]
  prompts       AgentPrompt[]
  versionTypes  VersionType[]
  productGroups ProductGroup[]
}

model Project {
  id          String      @id @default(cuid())
  name        String
  alias       String?
  description String?
  type           ProjectType     @default(NORMAL)
  gitUrl         String?
  localPath      String?
  projectType    ProjectCategory @default(FRONTEND)
  previewCommand String?
  previewPort    Int?
  previewPreset  String?
  previewInstallCommand String?
  // 知识库：groupId 把同一产品的多个仓库（前后端/trace/需求）归入一个 ProductGroup，
  // 问答时自动把同组兄弟项目一起纳入检索。knowledgeDir 是 repo 内知识库目录（相对 localPath），
  // 留空则用约定默认（见 src/lib/knowledge.ts DEFAULT_KNOWLEDGE_DIR）。
  groupId        String?
  knowledgeDir   String?
  workspaceId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group        ProductGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tasks        Task[]
  repositories Repository[]
  notes        ProjectNote[]
  assets       ProjectAsset[]
  versions     Version[]
  facts        ProjectFact[]

  @@index([workspaceId])
  @@index([groupId])
}

/// 产品组：把同一产品的多个仓库（前后端 / trace 静态知识库 / 需求）归为一组。
/// 组内成员的知识（repo 知识目录 + 事实卡 + 版本/commit + 笔记）在问答时一起检索。
model ProductGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// 结构化「事实卡」：机器拿不到、需人工/AI 填的项目级 key-value（生产环境路径、
// CICD 路径、域名等）。知识库问答的精确命中源之一。key 在项目内唯一（upsert）。
model ProjectFact {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
}

model Label {
  id          String  @id @default(cuid())
  name        String
  color       String  @default("#94a3b8")
  workspaceId String?
  isBuiltin   Boolean @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@index([workspaceId])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  order       Int        @default(0)
  pinned      Boolean    @default(false)
  promptId    String?
  baseBranch  String?
  subPath     String?
  parentTaskId String?   // 派生来源：派生此任务的父任务 id（父任务终端注入的 TOWER_TASK_ID）。裸字符串无 relation，与 promptId 同惯例
  previewCommandOverride String?
  previewPortOverride    Int?
  projectId   String
  versionId   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  doneAt      DateTime?  // 进入 DONE 的时间戳，用于「归档期限」判定（离开 DONE 时清空）

  // Goal-mode runtime marker (NOT a task-creation setting). Set to true only when the
  // agent activates the tower-goal skill at run time (set_goal_mode), and auto-cleared
  // when the task leaves the active loop (Stop / DONE / CANCELLED / IN_REVIEW). While true,
  // list_notify_targets defaults the scope to 'unattended' (reach the owner). Tower only
  // records + park/resume — it never sends and never stores platform bindings.
  unattended    Boolean   @default(false)

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions TaskExecution[]
  messages   TaskMessage[]
  labels     TaskLabel[]
  notes      ProjectNote[]
  assets     ProjectAsset[]
  harnessMessages HarnessMessage[]
  version    Version?        @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([versionId])
  @@index([parentTaskId])
}

model TaskExecution {
  id             String          @id @default(cuid())
  taskId         String
  agent          String          @default("CLAUDE_CODE")
  config         String?         @default("DEFAULT")
  status         ExecutionStatus @default(PENDING)
  branch         String?
  sessionId      String?
  worktreePath   String?
  worktreeBranch String?
  startedAt      DateTime?
  endedAt        DateTime?
  summary        String?
  gitLog         String?
  gitStats       String?
  exitCode       Int?
  callbackUrl    String?
  terminalLog    String?
  forkCommit      String?
  mergeCommit     String?
  branchTipCommit String?
  createdAt      DateTime        @default(now())

  insightNoteId   String?
  insightNote     ProjectNote? @relation(fields: [insightNoteId], references: [id], onDelete: SetNull)

  task     Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  messages TaskMessage[]

  @@index([taskId])
  @@index([insightNoteId])
}

// 无人值守：一张表记所有 harness→人 的消息（ask/notify/done/failed）—— 纯记录/日志，Tower 不发送。
// - kind='ask' 是 park/resume 闭环载体，带生命周期 state：OPEN→ANSWERED|CANCELLED|IGNORED|EXPIRED。
// - notify/done/failed 是日志行，出生即 CLOSED，不参与「待回复」过滤。
// - 不变量：待回复 = kind='ask' AND state='OPEN'。回复内容记在 replyText（reply_to_ask 写入）。
model HarnessMessage {
  id           String   @id @default(cuid())
  taskId       String
  executionId  String?
  kind         String   // "ask" | "notify" | "done" | "failed"（映射 OutboundKind）
  content      String
  replyText    String?
  repliedAt    DateTime?
  state        HarnessState @default(OPEN)
  createdAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, kind, state])
  @@index([state])
}

enum HarnessState {
  OPEN
  ANSWERED
  CANCELLED
  IGNORED
  EXPIRED
  CLOSED
}

model TaskMessage {
  id          String      @id @default(cuid())
  role        MessageRole
  content     String
  taskId      String
  executionId String?
  metadata    String?
  createdAt   DateTime    @default(now())

  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  execution TaskExecution? @relation(fields: [executionId], references: [id])

  @@index([taskId])
  @@index([executionId])
}

model Repository {
  id        String   @id @default(cuid())
  name      String
  path      String
  branch    String   @default("main")
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Version {
  id            String        @id @default(cuid())
  number        String
  name          String
  typeId        String?
  status        VersionStatus @default(PLANNED)
  isCurrent     Boolean       @default(false)
  baseBranch    String?
  baseCommit    String?
  releaseCommit String?
  startDate     DateTime?
  targetDate    DateTime?
  releasedAt    DateTime?
  description   String?
  order         Int           @default(0)
  projectId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type    VersionType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([projectId])
  @@index([isCurrent])
  @@index([typeId])
}

model VersionType {
  id          String    @id @default(cuid())
  name        String
  workspaceId String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    Version[]

  @@index([workspaceId])
}

model ProjectNote {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("备忘")
  projectId String
  taskId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  insightExecutions TaskExecution[]

  @@index([projectId])
  @@index([taskId])
  @@index([category])
}

model ProjectAsset {
  id          String   @id @default(cuid())
  filename    String
  path        String
  mimeType    String?
  size        Int?
  description String?  @default("")
  projectId   String
  taskId      String?
  // 自动上传去重：sourceKey 是来源文件的稳定逻辑标识（剥离 worktree 前缀的项目相对路径），
  // contentHash 是内容 sha256。同一文件再次写入按 (projectId, sourceKey) 就地更新，
  // 内容未变则幂等跳过 —— 避免每次编辑都追加时间戳生成新资产。旧记录二者为 null。
  sourceKey   String?
  contentHash String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([projectId, sourceKey])
  @@index([projectId])
  @@index([taskId])
}

model AgentConfig {
  id           String   @id @default(cuid())
  agent        String
  configName   String
  appendPrompt String?
  settings     String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([agent, configName])
}

model CliProfile {
  id        String   @id @default(cuid())
  name      String   @unique
  command   String
  baseArgs  String   @default("[]")
  envVars   String   @default("{}")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiCapabilityConfig {
  id        String   @id @default(cuid())
  slot      String   @unique
  provider  String   @default("claude")
  mode      String   @default("cli")
  model     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentPrompt {
  id          String     @id @default(cuid())
  name        String
  description String?
  content     String
  isDefault   Boolean    @default(false)
  workspaceId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per AI provider that has been tested via Settings → Test Connection.
/// Capability slots can only select a provider that has a row here with
/// testOk=true and the relevant integrations installed. See
/// .notes/ai-provider-integration.md and .notes/ai-capability-slots.md.
model ProviderConnection {
  id              String   @id @default(cuid())
  /// Provider key from providerRegistry: "claude" | "codex" | ...
  provider        String   @unique
  /// Last time the user clicked Test Connection (regardless of outcome).
  lastTestedAt    DateTime?
  /// Outcome of the last hello probe.
  testOk          Boolean  @default(false)
  /// CLI version captured at last test, e.g. "1.0.0 (Claude Code)".
  version         String?
  mcpInstalled    Boolean  @default(false)
  hooksInstalled  Boolean  @default(false)
  skillsInstalled Boolean  @default(false)
  /// Most recent install report, for debugging / Show Last Install button.
  installLog      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Ledger of one-shot data migrations applied to THIS database (see
/// scripts/run-migrations.ts + scripts/migrations/). Bound to the DB so the
/// "already migrated" record can never drift from the data it describes.
model AppliedMigration {
  /// Migration id = filename without extension, e.g. "0001-insight-category".
  id        String   @id
  appliedAt DateTime @default(now())
}

enum ProjectType {
  NORMAL
  GIT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutionStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ProjectCategory {
  FRONTEND
  BACKEND
}

enum VersionStatus {
  PLANNED
  ACTIVE
  RELEASED
}
